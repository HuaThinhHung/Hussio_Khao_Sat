# Biến môi trường của API /api/claim (đặt trên Vercel › Settings › Environment Variables, môi trường Production).
# Không đưa giá trị thật vào repo.

# Đã có sẵn trên Vercel
BLOB_STORE_ID=            # kho Blob private "hussio-voucher-ks20" (xác thực OIDC, không cần token)
KS20_CODES=               # 300 mã HUSSIO_KS20_XXXXXX, cách nhau bằng dấu phẩy (Secret)

# Cần thêm để ghi Sheet "Kho mã" bằng Google Sheets API
GOOGLE_SERVICE_ACCOUNT_JSON=   # nguyên nội dung file JSON khoá của tài khoản dịch vụ Google Cloud (Secret).
                               # Sheet phải chia sẻ quyền Người chỉnh sửa cho "client_email" trong file này.
KS20_ADMIN_KEY=                # chuỗi ngẫu nhiên dài; gửi ở header x-admin-key khi gọi ?resync / ?sync-status
CRON_SECRET=                   # chuỗi ngẫu nhiên; Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>"

# Tuỳ chọn
LOG_FORM_MIRROR=               # 1 = gửi thêm Mã + SĐT vào form ẩn "Sổ phát voucher" (mặc định tắt)
